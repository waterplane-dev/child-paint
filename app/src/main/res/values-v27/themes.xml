<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge stops at the display cutout unless the window is told it may
         lay out into it; without this the notch strip stays black in kid mode. -->
    <style name="Theme.ChildPaint" parent="Base.Theme.ChildPaint">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
