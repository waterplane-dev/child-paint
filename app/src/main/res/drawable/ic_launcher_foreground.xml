<?xml version="1.0" encoding="utf-8"?>
<!-- A sheet of paper with a rainbow on it and the brush that painted it. Every
     part sits inside the 66dp safe circle, so no launcher mask cuts it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:rotation="-8" android:pivotX="54" android:pivotY="54">
        <!-- Shadow, then the paper. -->
        <path
            android:fillColor="#2E000000"
            android:pathData="M36,32.5 L74,32.5 A5,5 0 0 1 79,37.5 L79,81 A5,5 0 0 1 74,86 L36,86 A5,5 0 0 1 31,81 L31,37.5 A5,5 0 0 1 36,32.5 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M34,30 L74,30 A5,5 0 0 1 79,35 L79,79 A5,5 0 0 1 74,84 L34,84 A5,5 0 0 1 29,79 L29,35 A5,5 0 0 1 34,30 Z" />
        <!-- The rainbow: three arcs, fat and round-capped like crayon. -->
        <path
            android:pathData="M37,66 A17,17 0 0 1 71,66"
            android:strokeColor="#FF5A5F" android:strokeWidth="5" android:strokeLineCap="round" />
        <path
            android:pathData="M43,66 A11,11 0 0 1 65,66"
            android:strokeColor="#FFC93C" android:strokeWidth="5" android:strokeLineCap="round" />
        <path
            android:pathData="M49,66 A5,5 0 0 1 59,66"
            android:strokeColor="#4CD964" android:strokeWidth="5" android:strokeLineCap="round" />
    </group>
    <!-- The brush, leaning in from the corner with its tip on the rainbow's end. -->
    <group android:rotation="-45" android:pivotX="70" android:pivotY="70">
        <path
            android:fillColor="#8B5A2B"
            android:pathData="M66.5,68.5 L73.5,68.5 L73.5,80 A3.5,3.5 0 0 1 66.5,80 Z" />
        <path
            android:fillColor="#D6D6D6"
            android:pathData="M65.5,64.5 L74.5,64.5 L74.5,68.5 L65.5,68.5 Z" />
        <path
            android:fillColor="#FF8A3D"
            android:pathData="M70,57 L74.5,64.5 L65.5,64.5 Z" />
    </group>
</vector>
