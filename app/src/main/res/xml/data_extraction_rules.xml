<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ rules. android:allowBackup="false" switches off cloud backup, but on
  Android 12+ it does not by itself stop device-to-device transfer, so this file
  excludes every domain from BOTH. Nothing the app stores (drawings, saved
  pictures, the kid-mode PIN and session) ever leaves the device through the OS.
  A phone set up from another one starts with an empty app, by design.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
