<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below. android:allowBackup="false" already disables backup; this
  file additionally excludes every domain so nothing is ever backed up even if
  that flag were flipped by mistake. Android 12+ uses data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
