<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- The keyboard's target for the text tool. It is never seen: what it holds is
     drawn into the box on the paper, letter by letter, where the child drew it.
     First child so everything else covers it. -->
<EditText
    android:id="@+id/textInput"
    android:layout_width="1dp"
    android:layout_height="1dp"
    android:alpha="0"
    android:background="@null"
    android:importantForAutofill="no"
    android:inputType="text|textCapSentences"
    android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
    android:maxLength="200" />

<!-- White behind both the paper and the tray, so the tray's rounded top corners
     show paper in the notches and the tray reads as lying on the page. -->
<LinearLayout
    android:id="@+id/paperColumn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/face">

    <com.childpaint.PaintCanvasView
        android:id="@+id/paintView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Every control is on screen at once: a child should never have to scroll
         a toolbar to find the star. Rows are weight-filled so they fit any width.
         With the hide-the-tools extra on, this whole block is moved into
         toolbarOverlay below and floats over the paper instead. Children are not
         clipped because a pressed button squishes and a chosen colour grows. -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/tray"
        android:elevation="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <com.childpaint.BrushSizeSlider
            android:id="@+id/sizeBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginHorizontal="4dp" />

        <LinearLayout
            android:id="@+id/toolGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>
</LinearLayout>

    <!-- Where the toolbar lives when the hide-the-tools extra is on. It overlays
         the paper rather than sitting above it in the column: taking the toolbar
         out of the layout would resize the canvas every time it opened, and the
         bitmap is recreated on a size change while op coordinates are canvas
         pixels — the picture would shift under the child twice a minute. -->
    <FrameLayout
        android:id="@+id/toolbarOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false" />

    <!-- The way back to the tools once they are hidden. Deliberately a chunky
         target at the bottom edge, in the same chrome as every other button. -->
    <ImageView
        android:id="@+id/toolbarHandle"
        android:layout_width="96dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_chevron_up"
        android:scaleType="fitCenter"
        android:paddingTop="7dp"
        android:paddingBottom="11dp"
        android:contentDescription="@string/show_tools"
        android:visibility="gone" />

    <!-- Kid-mode chrome. All gone in parent mode; the overlay sits above the
         toolbar too, so an expired session blocks the tools as well as the paper. -->
    <!-- Time left is a draining bar across the top of the paper, not a clock. A
         ticking mm:ss is a stress machine for a child who can read it and
         meaningless to one who cannot; a bar just gets shorter. It spans the full
         width so it reads from across the room, and the last minute also says so
         in words for the grown-up. -->
    <LinearLayout
        android:id="@+id/timerHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/timerBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:progressDrawable="@drawable/timer_progress"
            android:max="1000"
            android:progress="1000" />

        <TextView
            android:id="@+id/lastMinuteLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="@string/last_minute"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The in-app hint that stands in for a toast: a dark pill at the top of the
         paper, faded in and out by the activity. -->
    <TextView
        android:id="@+id/hintPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/hint_pill"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingHorizontal="22dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/expiredOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:padding="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card"
            android:elevation="16dp"
            android:padding="28dp">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@drawable/ic_moon"
                app:tint="@color/accent"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/time_up_title"
                android:textColor="@color/ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/time_up_hint"
                android:textColor="@color/ink_soft"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/expiredUnlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/button_accent"
                android:paddingHorizontal="28dp"
                android:paddingTop="14dp"
                android:paddingBottom="18dp"
                android:text="@string/grown_ups"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="10dp"
                android:drawableTint="@color/on_accent"
                android:textColor="@color/on_accent"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
