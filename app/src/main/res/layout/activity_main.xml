<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chrome">

    <com.childpaint.PaintCanvasView
        android:id="@+id/paintView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Every control is on screen at once: a child should never have to scroll
         a toolbar to find the star. Rows are weight-filled so they fit any width. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <View
                android:id="@+id/sizePreview"
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <SeekBar
                android:id="@+id/sizeBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:max="100"
                android:progress="16" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>

    <!-- Kid-mode chrome. All gone in parent mode; the overlay sits above the
         toolbar too, so an expired session blocks the tools as well as the paper. -->
    <TextView
        android:id="@+id/timerBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        />

    <TextView
        android:id="@+id/lockCorner"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:gravity="center"
        android:textSize="18sp"
        android:alpha="0.45"
        android:text="@string/lock_glyph"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/expiredOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F21A1008"
        android:clickable="true"
        android:focusable="true"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_up_glyph"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/time_up_title"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/time_up_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/expiredUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:text="@string/grown_ups"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
