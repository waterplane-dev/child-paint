<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/paperColumn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chrome">

    <com.childpaint.PaintCanvasView
        android:id="@+id/paintView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Every control is on screen at once: a child should never have to scroll
         a toolbar to find the star. Rows are weight-filled so they fit any width.
         With the hide-the-tools extra on, this whole block is moved into
         toolbarOverlay below and floats over the paper instead. -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/chrome"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <View
                android:id="@+id/sizePreview"
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <SeekBar
                android:id="@+id/sizeBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:max="100"
                android:progress="16" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>

    <!-- Where the toolbar lives when the hide-the-tools extra is on. It overlays
         the paper rather than sitting above it in the column: taking the toolbar
         out of the layout would resize the canvas every time it opened, and the
         bitmap is recreated on a size change while op coordinates are canvas
         pixels — the picture would shift under the child twice a minute. -->
    <FrameLayout
        android:id="@+id/toolbarOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <!-- The way back to the tools once they are hidden. Deliberately a chunky
         target at the bottom edge, in the same chrome as every other button. -->
    <ImageView
        android:id="@+id/toolbarHandle"
        android:layout_width="86dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:src="@drawable/ic_chevron_up"
        android:scaleType="fitCenter"
        android:paddingVertical="6dp"
        android:contentDescription="@string/show_tools"
        android:visibility="gone" />

    <!-- Kid-mode chrome. All gone in parent mode; the overlay sits above the
         toolbar too, so an expired session blocks the tools as well as the paper. -->
    <!-- Time left is a draining bar across the top of the paper, not a clock. A
         ticking mm:ss is a stress machine for a child who can read it and
         meaningless to one who cannot; a bar just gets shorter. It spans the full
         width so it reads from across the room, and the last minute also says so
         in words for the grown-up. -->
    <LinearLayout
        android:id="@+id/timerHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/timerBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:max="1000"
            android:progress="1000" />

        <TextView
            android:id="@+id/lastMinuteLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/last_minute"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/expiredOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F21A1008"
        android:clickable="true"
        android:focusable="true"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_lock"
            android:alpha="0.85"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/time_up_title"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/time_up_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/expiredUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:text="@string/grown_ups"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFFFF"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
